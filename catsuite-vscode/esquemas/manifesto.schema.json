{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatSuite · Plugin",
  "anyOf": [
    {
      "not": {
        "required": [
          "apiVersion"
        ]
      }
    },
    {
      "type": "object",
      "required": [
        "formatVersion",
        "apiVersion",
        "id",
        "version",
        "author",
        "entry",
        "name",
        "description",
        "permissions",
        "targets",
        "externalHosts",
        "hashes"
      ],
      "properties": {
        "formatVersion": {
          "enum": [
            1,
            2
          ]
        },
        "apiVersion": {
          "const": 1
        },
        "requiresSdk": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0",
            "1.4.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,63}$",
          "description": "Identidade permanente / Permanent identity"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "pattern": "^[^\\\\:]+\\.js$"
        },
        "revisionId": {
          "type": "string",
          "format": "uuid"
        },
        "lineageId": {
          "type": "string",
          "format": "uuid"
        },
        "parentRevision": {
          "type": "string"
        },
        "name": {
          "type": "object",
          "required": [
            "pt-BR",
            "en"
          ],
          "properties": {
            "pt-BR": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "description": {
          "type": "object",
          "required": [
            "pt-BR",
            "en"
          ],
          "properties": {
            "pt-BR": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "traffic.read",
              "traffic.modify",
              "http.send",
              "external.call",
              "ui.menu",
              "ui.tab",
              "storage",
              "findings",
              "repeater",
              "commands",
              "pipeline.step",
              "parsers",
              "connector.run"
            ]
          },
          "uniqueItems": true,
          "maxItems": 13
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "externalHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "settings": {
          "type": "object"
        },
        "settingsSchema": {
          "type": "object"
        },
        "signature": {
          "type": "object",
          "required": [
            "algorithm",
            "publicKey",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "Ed25519"
            },
            "publicKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
