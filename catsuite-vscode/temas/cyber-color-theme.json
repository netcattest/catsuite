  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#A0ABBC"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#8DE2B2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E8B5EF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#97C7FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8ADDD6"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#EEF1F6"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#97C7FF",
    "method": "#97C7FF",
    "class": "#8ADDD6",
    "parameter": "#EEF1F6",
    "property": "#EEF1F6",
    "variable.readonly": "#D9C56A"
  }
