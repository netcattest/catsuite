    "advisories.aurora.test"
  ],
  "methods": [
    "GET",
    "HEAD"
  ],
  "connectors": [],
  "nodes": [
    {
      "id": "capture",
      "kind": "capture",
      "inputs": [],
      "outputs": [
        "http"
      ],
      "config": {},
      "x": 80,
      "y": 70
    },
    {
      "id": "jwt",
      "kind": "extension",
      "inputs": [
        "http"
      ],
      "outputs": [
        "http",
        "jwt"
      ],
      "config": {},
      "x": 80,
      "y": 215,
      "extension": "lab.jwt",
      "step": "identity.jwt"
    },
    {
      "id": "secrets",
      "kind": "extension",
      "inputs": [
        "http",
        "jwt"
      ],
      "outputs": [
        "http",
        "jwt",
        "secret"
      ],
      "config": {},
      "x": 80,
      "y": 360,
      "extension": "lab.secrets",
      "step": "identity.secrets"
    },
    {
      "id": "authorization",
      "kind": "extension",
      "inputs": [
        "http",
        "jwt",
        "secret"
      ],
      "outputs": [
        "http",
        "jwt",
        "secret",
        "analysis",
        "finding"
      ],
      "config": {},
      "x": 80,
      "y": 505,
      "extension": "lab.authorization",
      "step": "identity.authorization"
    },
    {
      "id": "report",
      "kind": "extension",
      "inputs": [
        "http",
        "jwt",
        "secret",
        "analysis",
        "finding",
        "endpoint",
        "record"
      ],
      "outputs": [
        "record"
      ],
      "config": {},
      "x": 80,
      "y": 650,
      "extension": "lab.report",
      "step": "identity.report"
    }
  ],
  "edges": [
    {
      "from": "capture",
      "to": "jwt"
    },
    {
      "from": "jwt",
      "to": "secrets"
    },
    {
      "from": "secrets",
      "to": "authorization"
    },
    {
      "from": "authorization",
      "to": "report"
    }
  ],
