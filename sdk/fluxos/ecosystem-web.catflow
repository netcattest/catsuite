{
  "format": "catflow",
  "formatVersion": 5,
  "requiresSdk": "1.4.0",
  "id": "e900f7eb-5bfa-525a-8d4d-b07eb6789fda",
  "name": {
    "pt-BR": "Avaliação web e TLS — Laboratório",
    "en": "Web and TLS assessment — Laboratory"
  },
  "trigger": "manual",
  "network": false,
  "laboratory": true,
  "protection": "PUBLIC",
  "targets": [
    "https://api.aurora.test"
  ],
  "methods": [
    "GET"
  ],
  "connectors": [
    "catsuite.laboratory"
  ],
  "nodes": [
    {
      "id": "capture",
      "kind": "capture",
      "inputs": [],
      "outputs": [
        "http"
      ],
      "config": {},
      "x": 80,
      "y": 70
    },
    {
      "id": "step0",
      "kind": "connector",
      "inputs": [
        "http",
        "endpoint"
      ],
      "outputs": [
        "analysis",
        "endpoint"
      ],
      "config": {
        "connector": "catsuite.laboratory",
        "tool": "httpx",
        "capability": "http.probe",
        "parameters": {
          "profile": "read-only",
          "methods": [
            "GET"
          ],
          "requests": 50
        }
      },
      "x": 80,
      "y": 255
    },
    {
      "id": "step1",
      "kind": "connector",
      "inputs": [
        "http",
        "endpoint"
      ],
      "outputs": [
        "analysis",
        "endpoint"
      ],
      "config": {
        "connector": "catsuite.laboratory",
        "tool": "katana",
        "capability": "web.crawl",
        "parameters": {
          "profile": "read-only",
          "methods": [
            "GET"
          ],
          "requests": 100,
          "depth": 2,
          "pages": 25
        }
      },
      "x": 80,
      "y": 440
    },
    {
      "id": "step2",
      "kind": "connector",
      "inputs": [
        "http",
        "endpoint"
      ],
      "outputs": [
        "analysis",
        "finding"
      ],
      "config": {
        "connector": "catsuite.laboratory",
        "tool": "testssl",
        "capability": "tls.assess",
        "parameters": {
          "profile": "active-approved",
          "methods": [
            "GET"
          ],
          "requests": 50,
          "maxResults": 200,
          "ports": [
            443
          ]
        }
      },
      "x": 80,
      "y": 625
    },
    {
      "id": "step3",
      "kind": "connector",
      "inputs": [
        "http",
        "endpoint"
      ],
      "outputs": [
        "analysis",
        "finding"
      ],
      "config": {
        "connector": "catsuite.laboratory",
        "tool": "nikto",
        "capability": "web.server.assess",
        "parameters": {
          "profile": "active-approved",
          "methods": [
            "GET"
          ],
          "requests": 50,
          "maxResults": 200
        }
      },
      "x": 80,
      "y": 810
    },
    {
      "id": "report",
      "kind": "report",
      "inputs": [
        "http",
        "record",
        "endpoint",
        "analysis",
        "finding"
      ],
      "outputs": [
        "record"
      ],
      "config": {},
      "x": 80,
      "y": 995
    }
  ],
  "edges": [
    {
      "from": "capture",
      "to": "step0"
    },
    {
      "from": "capture",
      "to": "step1"
    },
    {
      "from": "capture",
      "to": "step2"
    },
    {
      "from": "capture",
      "to": "step3"
    },
    {
      "from": "step0",
      "to": "report"
    },
    {
      "from": "step1",
      "to": "report"
    },
    {
      "from": "step2",
      "to": "report"
    },
    {
      "from": "step3",
      "to": "report"
    }
  ],
  "parentRevision": null
}
